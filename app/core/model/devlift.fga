# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║ HISTORICAL — DO NOT PUBLISH. This is NOT the live model.                   ║
# ╚═══════════════════════════════════════════════════════════════════════════╝
#
# An earlier 16-type reset of the same idea, with country / geo_location /
# cloud_account and per-resource sqs/s3/dynamo/db objects. Superseded before
# it was ever published.
#
# The live model is rbac-model.fga in this directory (mirror) and
# devlift-secret-config-manager-vance/app/core/authz/rbac-model.fga (authority,
# published from there). Live is model 01M0G32F1SFJTZMXMH16J2G963 on store
# 01KZCADQJ1Q3HPAW6EN4QWD8WR.
#
# Publishing this file would repoint `service.parent` at `cloud_account` while every
# one of the ~1556 live parent tuples points at resource_group, so every check
# would resolve to false and the whole product would lock out — the same
# re-parenting outage that had to be repaired by hand once already. It also
# lacks can_write_settings, can_write_gateway, can_view_settings and
# can_approve entirely, so approvals and the settings/gateway guards would fail
# closed.
#
# Kept only as the reference for the fuller hierarchy that returns in a later
# phase. Read it for shape; do not feed it to `fga model write`.

model
  schema 1.1

# devlift.ai — infra management authorization (reset)
#
# Object path (unchanged):
#   tenant → workspace → product → resource_group
#     → environment → country → geo_location → cloud_account
#       → service → secret
#       → sqs / s3 / dynamo / db
#
# Role mapping starts at RESOURCE GROUP. Levels above are structure only.
#
#   resource_group admin  — full permission for every operation on everything
#                           below, EXCEPT viewing secret values. Secrets may
#                           be created/updated/deleted, never read.
#   service owner         — the same powers, scoped to that one service
#                           (and its secrets: manage yes, view no).
#   secret reader         — the ONLY way to view a secret value: an explicit
#                           grant on that secret (JIT/time-boxed supported).

type user

type group
  relations
    define member: [user, group#member]

# ── structure only above resource group ──────────────────────────────────────
type tenant

type workspace
  relations
    define parent: [tenant]

type product
  relations
    define parent: [workspace, tenant]

# ── Resource group — where roles begin ───────────────────────────────────────
type resource_group
  relations
    define parent: [product]
    define admin: [user, group#member]

# ── pass-through levels: admin flows down from the resource group ────────────
type environment
  relations
    define parent: [resource_group]
    define admin: admin from parent
    define can_view: admin
    define can_create_service: admin
    define can_create_resource: admin

type country
  relations
    define parent: [environment]
    define admin: admin from parent

type geo_location
  relations
    define parent: [country]
    define admin: admin from parent

type cloud_account
  relations
    define parent: [geo_location]
    define admin: admin from parent
    define can_view: admin
    define can_create_service: admin
    define can_create_resource: admin

# ── Service: rg admin inherited, owner scoped to this service ────────────────
type service
  relations
    define parent: [cloud_account, environment]
    define owner: [user, group#member]
    define admin: owner or admin from parent

    define can_view: admin
    define can_update: admin
    define can_configure: admin
    define can_delete: admin
    define can_deploy: admin
    define can_restart: admin
    define can_start_service: admin
    define can_stop_service: admin
    define can_pr: admin
    define can_create_secret: admin

# ── Data & messaging resources: same shape as service ────────────────────────
type sqs
  relations
    define parent: [cloud_account, environment]
    define owner: [user, group#member]
    define admin: owner or admin from parent
    define can_view: admin
    define can_create: admin
    define can_update: admin
    define can_delete: admin
    define can_read: admin
    define can_write: admin

type s3
  relations
    define parent: [cloud_account, environment]
    define owner: [user, group#member]
    define admin: owner or admin from parent
    define can_view: admin
    define can_create: admin
    define can_update: admin
    define can_delete: admin
    define can_read: admin
    define can_write: admin

type dynamo
  relations
    define parent: [cloud_account, environment]
    define owner: [user, group#member]
    define admin: owner or admin from parent
    define can_view: admin
    define can_create: admin
    define can_update: admin
    define can_delete: admin
    define can_read: admin
    define can_write: admin

type db
  relations
    define parent: [cloud_account, environment]
    define owner: [user, group#member]
    define admin: owner or admin from parent
    define can_view: admin
    define can_create: admin
    define can_update: admin
    define can_delete: admin
    define can_read: admin
    define can_write: admin

# ── Secret: manage ≠ view ────────────────────────────────────────────────────
# rg admins and the service owner MANAGE secrets (create/update/delete)
# but can NOT view values. Viewing needs an explicit reader grant —
# optionally time-boxed via the JIT condition.
type secret
  relations
    define parent: [service]
    define manager: [user, group#member] or admin from parent
    define reader: [user, group#member, user with active_jit_grant]

    define can_create: manager
    define can_update: manager
    define can_delete: manager
    define can_read: reader
    define can_view: reader

# Time-boxed elevation: request access, it evaporates on its own.
condition active_jit_grant(current_time: timestamp, grant_expires_at: timestamp) {
  current_time < grant_expires_at
}
