# PostgreSQL
DB_USER=app_user
DB_PASSWORD=StrongPassword123!
DB_HOST=13.201.136.79
DB_PORT=5432
DB_NAME=app_db
# Optional SELECT-only role for the MCP query_data tool (scripts/sql/create_devlift_mcp_ro_role.sql).
# Empty = fall back to DB_USER with a warning (local dev only).
DB_RO_USER=
DB_RO_PASSWORD=

# Datadog
DATADOG_API_KEY=df75fac5ec40d804bfa9e17d6202d98b
DATADOG_APP_KEY=9f165180a4f0a5a1d357229e2a1a19758d6fd4a1
DATADOG_BASE_URL=https://api.datadoghq.eu/api/v1/monitor

# Clerk Authentication
SIGNING_SECRET=whsec_iLhB0tb4RayrTzUJKphZ7uhProkGVsdW
CLERK_SECRET_KEY=$[CLERK_SECRET_KEY]
CLERK_ISSUER=https://liked-redfish-5.clerk.accounts.dev
CLERK_JWKS_URL=https://liked-redfish-5.clerk.accounts.dev/.well-known/jwks.json

# GitHub
GITHUB_BASE_URL=https://api.github.com
OPENAI_API_KEY=$[OPENAI_API_KEY]

# GitHub App (multi-tenant: installation IDs stored in DB)
GITHUB_APP_ID=$[GITHUB_APP_ID]
GITHUB_APP_SLUG=$[GITHUB_APP_SLUG]
GITHUB_APP_PRIVATE_KEY_BASE64=$[GITHUB_APP_PRIVATE_KEY_BASE64]
GITHUB_APP_WEBHOOK_SECRET=$[GITHUB_APP_WEBHOOK_SECRET]
GITHUB_APP_PLATFORM_INSTALLATION_ID=$[GITHUB_APP_PLATFORM_INSTALLATION_ID]
# Logins the GitHub Apps push as — one per app. A login missing here is treated
# as a human editing the PR, which terminates the deployment.
DEVLIFT_GIT_BOTS=devlift-regobs[bot],devlift-ai[bot]

LANGFUSE_SECRET_KEY=$[LANGFUSE_SECRET_KEY]
LANGFUSE_PUBLIC_KEY=$[LANGFUSE_PUBLIC_KEY]
LANGFUSE_HOST=https://cloud.langfuse.com

# LangSmith (for LangGraph tracing)
LANGCHAIN_API_KEY=$[LANGCHAIN_API_KEY]
LANGCHAIN_TRACING_V2=true
LANGSMITH_PROJECT=infra-chat


# Infrastructure Git Folder Structure
INFRA_VERSION_INDEX=01
INFRA_REGION_DEV=ap-south-1
INFRA_REGION_STAGING=ap-south-1
INFRA_REGION_PROD=eu-west-2
INFRA_RESOURCE_TYPE=s3-bucket

# Datadog Terraform/Terragrunt Settings
DATADOG_TERRAFORM_REPO=Regobs/terraform-test
DATADOG_TERRAFORM_BRANCH=main
DATADOG_USE_TERRAGRUNT=true
DATADOG_USE_PR_WORKFLOW=true

# Kong Gateway Route Validation
KONG_ENABLE_DUPLICATE_CHECK=false
KONG_ENABLE_ENHANCED_ERROR_MESSAGES=true

# Logging Configuration
LOG_FILE=./logs/app.log
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30

# Qdrant Vector Database (for Service Sage semantic matching)
QDRANT_ENABLED=false
# Option 1: Use URL (recommended for ALB/proxy with path prefixes)
QDRANT_URL=
# Option 2: Use host:port (for direct connection)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_TIMEOUT=60
QDRANT_COLLECTION_NAME=service_parameters
QDRANT_CONFIGS_COLLECTION=service_configs

# Embedding Model
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Vector Similarity Thresholds (OpenAI embeddings typically score 0.3-0.5 for semantic matches)
VECTOR_MATCH_AUTO_ACCEPT=0.45
VECTOR_MATCH_UNCERTAIN=0.30

USE_AGENTIC_CONFIG_CHAT=true

# Redis Cache Configuration (for multi-worker state management)
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TIMEOUT=5

# Vercel Domain Provisioning (for auto-creating tenant subdomains on signup)
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
BASE_DOMAIN=devlift.ai
RESERVED_SUBDOMAINS=be,accounts,clerk,clkmail,dev,www,api,mail,admin,ftp,staging,status

#GUARDRAIL
INFRA_CHAT_GUARDRAILS_ENABLED=true

# Chat-bot-POC backend (source of truth for resource metadata + validation)
NEW_CHAT_BACKEND_URL=https://be.aspora.devlift.ai/chatbot

# MCP -> chatbot internal JWT (HS256). Generate a strong random secret in prod;
# the chatbot relays this token on outgoing calls back into obs_tool's APIs,
# which need a matching HS256 validator that recognizes type="mcp_internal".
MCP_INTERNAL_JWT_SECRET=
MCP_INTERNAL_JWT_TTL=900
# MCP data-question fallback (describe_data_schema / query_data)
MCP_DATA_QUERY_ENABLED=true
MCP_DATA_QUERY_TIMEOUT_MS=15000
MCP_DATA_QUERY_MAX_ROWS=200

# Variable save/deploy flow — temp staging + audit trail buckets + KMS key
SECRET_TEMP_BUCKET=
SECRET_AUDIT_BUCKET=
SECRET_AUDIT_KMS_KEY_ID=

# AI-generated PR titles/descriptions from the changed files (VS Code Copilot style).
# Requires a valid OPENAI_API_KEY. Falls back to the deterministic template on any error.
PR_AI_NAMING_ENABLED=true

# Region of the documentation bucket (S3_DOCS_BUCKET). Separate from AWS_REGION
# because that one is shared by most of this service, so it cannot be moved to
# follow this bucket alone. Leave empty to keep using AWS_REGION.
DOCS_AWS_REGION=

# ArgoCD read-only API tokens, one per tenant + environment. The variable NAME
# is recorded in tenants_mst.config["argocd"][<env>]["token_env"] so nothing but
# the pointer lives in the database. A missing value just turns the live
# application status off for that environment.
ARGOCD_TOKEN_ASPORA_STAGE=
